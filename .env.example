# =================================================================
# مفاتيح الربط لتسجيل الدخول السريع (Google Cloud & Meta Facebook)
# منصة البرمجة والذكاء الاصطناعي - ثانية بكالوريا
# =================================================================

# 1) معرّف عميل جوجل (Google OAuth 2.0 Client ID)
# يتم استخراجه من Google Cloud Console (APIs & Services > Credentials > OAuth Client ID)
# النطاقات المطلوبة (Scopes): email, profile, openid
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2) معرّف تطبيق فيسبوك (Meta / Facebook App ID)
# يتم استخراجه من Meta for Developers (developers.facebook.com > My Apps > Facebook Login)
# الصلاحيات المطلوبة (Permissions): public_profile, email
VITE_FACEBOOK_APP_ID=your-facebook-app-id

# 3) مفاتيح سوبا بيز (Supabase Project URL & Anon Key)
# يتم استخراجها من لوحة تحكم سوبا بيز: Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 4) رابط نطاق الإنتاج عند الرفع (Production App Domain)
# VITE_APP_URL=https://ai-codelingo.pages.dev
